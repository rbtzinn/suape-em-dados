# Firebase Auth (configuração pública do app web)
NEXT_PUBLIC_FIREBASE_API_KEY=cole-a-api-key-publica-do-app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=suape-compliance-controle

# Toda conta existente e ativa no Firebase entra como VIEWER.
# Liste aqui somente quem terá privilégio de importar/administrar.
FIREBASE_ADMIN_EMAILS=roberto.gabriel2004@hotmail.com
FIREBASE_ANALYST_EMAILS=

# Sessão assinada do portal (somente no servidor)
SESSION_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Google Sheets por ponte privada do Apps Script (somente no servidor)
GOOGLE_SHEETS_ID=cole-o-id-da-planilha-privada
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# Use true apenas para demonstração local. Em produção, mantenha false.
DEMO_MODE=false
